          <span class="sub-active">Activo</span>
        </div>
      </div>
    </div>

    <!-- Bottom Nav -->
    <div class="bottom-nav">
      <button class="nav-item active" data-tab="inicio" onclick="switchTab('inicio')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>Inicio</span></button>
      <button class="nav-item" data-tab="ruta" onclick="switchTab('ruta')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg><span>Ruta</span></button>
      <button class="nav-item" data-tab="beneficios" onclick="switchTab('beneficios')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg><span>Beneficios</span></button>
      <button class="nav-item" data-tab="campanas" onclick="switchTab('campanas')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Seguridad</span></button>
      <button class="nav-item" data-tab="perfil" onclick="switchTab('perfil')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Perfil</span></button>
    </div>
  </div>

  <!-- Toast (dentro del frame) -->
  <div class="toast" id="toast">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    <span id="toastMsg"></span>
  </div>

</div>
<!-- /phone-frame -->

<script>
/* ============ SPLASH → LOGIN ============ */
window.addEventListener('load', () => {
  setTimeout(() => {
    document.getElementById('splash').classList.add('hide');
    document.getElementById('loginScreen').classList.remove('hide');
  }, 1600);
});

/* ============ ENTRAR A LA APP ============ */
function enterApp() {
  document.getElementById('loginScreen').classList.add('hide');
  document.getElementById('appRoot').style.visibility = 'visible';
  showToast('Bienvenido, Ezequiel');
}

/* ============ RELOJ REAL ============ */
function updateClock() {
  const now = new Date();
  const time = now.getHours() + ':' + String(now.getMinutes()).padStart(2,'0');
  document.getElementById('clock').textContent = time;
  const lc = document.getElementById('loginClock');
  if (lc) lc.textContent = time;
}
updateClock(); setInterval(updateClock, 30000);

/* ============ DARK MODE ============ */
function toggleTheme() {
  const html = document.documentElement;
  const next = html.dataset.theme === 'light' ? 'dark' : 'light';
  html.dataset.theme = next;
  localStorage.setItem('ausol-theme', next);
  document.body.style.background = next === 'dark' ? '#000' : '#e5e7eb';
  updateMapTheme();
  showToast(next === 'dark' ? 'Modo oscuro activado' : 'Modo claro activado');
}
(function initTheme(){
  const saved = localStorage.getItem('ausol-theme');
  if (saved) {
    document.documentElement.dataset.theme = saved;
    document.body.style.background = saved === 'dark' ? '#000' : '#e5e7eb';
  }
})();

/* ============ TOAST ============ */
let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
}

/* ============ TABS ============ */
const tabOrder = ['inicio','ruta','beneficios','campanas','perfil'];
let currentTab = 'inicio';
let mapInit = false;

function switchTab(name) {
  if (name === currentTab) return;
  const oldIdx = tabOrder.indexOf(currentTab);
  const newIdx = tabOrder.indexOf(name);
  const direction = newIdx > oldIdx ? 'right' : 'left';

  document.querySelectorAll('.tab-content').forEach(el => {
    el.classList.remove('active','slide-left');
  });
  const target = document.getElementById('tab-' + name);
  if (direction === 'left') target.classList.add('slide-left');
  target.classList.add('active');

  document.querySelectorAll('.nav-item').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.tab === name);
  });

  document.getElementById('appContent').scrollTop = 0;
  currentTab = name;

  if (name === 'ruta') setTimeout(initMap, 100);
  if (name === 'beneficios') animateProgress();
}

/* ============ MAPA LEAFLET ============ */
let map, tileLayer;
function getTileUrl() {
  const dark = document.documentElement.dataset.theme === 'dark';
  return dark
    ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
    : 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png';
}
function initMap() {
  if (mapInit) { map.invalidateSize(); return; }
  mapInit = true;

  map = L.map('map', { zoomControl:false, attributionControl:true }).setView([-34.4660,-58.5800], 12);
  tileLayer = L.tileLayer(getTileUrl(), { attribution:'© OpenStreetMap © CARTO', maxZoom:19 }).addTo(map);

  const route = [
    [-34.4432,-58.6550],[-34.4480,-58.6400],[-34.4550,-58.6200],
    [-34.4620,-58.5900],[-34.4700,-58.5600],[-34.4800,-58.5300],[-34.4898,-58.5087]
  ];
  L.polyline(route, { color:'#e67e22', weight:5, opacity:.9, dashArray:null }).addTo(map);

  const iconDot = (color, emoji) => L.divIcon({
    html:`<div style="width:26px;height:26px;border-radius:50%;background:${color};border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.3);display:flex;align-items:center;justify-content:center;font-size:12px;">${emoji}</div>`,
    className:'', iconSize:[26,26], iconAnchor:[13,13]
  });

  L.marker(route[0], {icon:iconDot('#0b5e7c','📍')}).addTo(map).bindPopup('Tortugas Open Mall');
  L.marker(route[route.length-1], {icon:iconDot('#0b5e7c','🏁')}).addTo(map).bindPopup('Unicenter');
  L.marker([-34.4550,-58.6150], {icon:iconDot('#e67e22','⛽')}).addTo(map).bindPopup('Puma Energy · Km 22');
  L.marker([-34.4650,-58.5750], {icon:iconDot('#e67e22','☕')}).addTo(map).bindPopup('Havanna Truck Stop');

  map.fitBounds(L.latLngBounds(route).pad(0.2));
}
function updateMapTheme() {
  if (tileLayer) tileLayer.setUrl(getTileUrl());
}

/* ============ PROGRESO CIRCULAR ============ */
function animateProgress() {
  const pct = 45;
  const circ = 2 * Math.PI * 45;
  const offset = circ * (1 - pct/100);
  setTimeout(() => {
    document.getElementById('ringFill').style.strokeDashoffset = offset;
    let count = 0;
    const el = document.getElementById('progressPct');
    const interval = setInterval(() => {
      count += 1;
      el.textContent = count + '%';
      if (count >= pct) clearInterval(interval);
    }, 20);
  }, 200);
}

/* ============ CAMPAÑAS ROTATIVAS ============ */
const campaigns = [
  { title:"El mensaje que envió mi papá le costó la vida", message:"El celular puede esperar. Conducir exige toda tu atención.", tag:"#CeroChoques",
    icon:'<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>' },
  { title:"Mantené distancia segura", message:"No te pegues al auto de adelante. Tu vida depende de los segundos de reacción.", tag:"#DistanciaSegura",
    icon:'<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>' },
  { title:"Usá el cinturón de seguridad", message:"Todas las personas del vehículo deben usar el cinturón. Salva vidas.", tag:"#TodosAtados",
    icon:'<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>' },
  { title:"Sin TelePASE es multa", message:"Art. 3° Res. DNV 3202/14. Manual pagás doble tarifa.", tag:"#TelePASE",
    icon:'<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' },
  { title:"No te detengas en la autopista", message:"Si no es emergencia, usá las áreas de descanso designadas.", tag:"#AutopistaSegura",
    icon:'<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>' }
];
let campaignIndex = 0;
function rotateCampaign() {
  const c = campaigns[campaignIndex];
  const banner = document.querySelector('.campaign-banner');
  banner.style.opacity = '0'; banner.style.transform = 'translateY(8px)';
  banner.style.transition = 'opacity .3s, transform .3s';
  setTimeout(() => {
    document.getElementById('campaignTitle').textContent = c.title;
    document.getElementById('campaignMessage').textContent = c.message;
    document.getElementById('campaignTag').textContent = c.tag;
    document.getElementById('campaignIcon').innerHTML = c.icon;
    banner.style.opacity = '1'; banner.style.transform = 'translateY(0)';
  }, 300);
  campaignIndex = (campaignIndex + 1) % campaigns.length;
}
setInterval(rotateCampaign, 8000);

/* ============ PULL-TO-REFRESH ============ */
const content = document.getElementById('appContent');
const ptr = document.getElementById('ptrIndicator');
let startY = 0, pulling = false;

content.addEventListener('touchstart', e => {
  if (currentTab === 'inicio' && content.scrollTop === 0) {
    startY = e.touches[0].pageY; pulling = true;
  }
}, {passive:true});

content.addEventListener('touchmove', e => {
  if (!pulling) return;
  const diff = e.touches[0].pageY - startY;
  if (diff > 0 && diff < 120) {
    ptr.style.opacity = Math.min(diff/80, 1);
    ptr.style.transform = `translateX(-50%) translateY(${diff*0.5}px)`;
  }
}, {passive:true});

content.addEventListener('touchend', e => {
  if (!pulling) return;
  pulling = false;
  const diff = e.changedTouches[0].pageY - startY;
  if (diff > 70) {
    ptr.style.opacity = 1;
    setTimeout(() => { rotateCampaign(); showToast('Contenido actualizado'); }, 600);
  }
  ptr.style.opacity = 0;
  ptr.style.transform = 'translateX(-50%) translateY(0)';
});
</script>
</body>
</html>
