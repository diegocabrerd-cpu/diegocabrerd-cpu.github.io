<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0f7b3a">
<title>AUSOL · GCO — Movilidad</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
/* =============================== */
/* VARIABLES DE TEMA */
/* =============================== */
:root {
  --ausol: #e67e22;
  --ausol-soft: #fef5e8;
  --ausol-deep: #c96a12;
  --gco: #0b5e7c;
  --gco-soft: #e7f3f7;
  --gco-deep: #07415a;

  --brand: #0f7b3a;
  --brand-soft: #e8f5ec;
  --brand-deep: #0a5c2a;

  --bg: #eef2f5;
  --bg-card: #ffffff;
  --bg-elevated: #f8fafc;
  --text-1: #1a2332;
  --text-2: #4a627a;
  --text-3: #8a9bb0;
  --border: #eef2f5;
  --shadow: 0 8px 24px rgba(11,94,124,0.08);
  --shadow-strong: 0 16px 40px rgba(11,94,124,0.14);
  --nav-bg: rgba(255,255,255,0.92);
  --danger: #dc2626;
  --danger-soft: #fdeaea;
}

[data-theme="dark"] {
  --ausol-soft: #2a1f12;
  --gco-soft: #0e2530;
  --brand-soft: #0f2818;
  --bg: #0d1117;
  --bg-card: #161b22;
  --bg-elevated: #1c2128;
  --text-1: #e6edf3;
  --text-2: #9ca3af;
  --text-3: #6b7280;
  --border: #21262d;
  --shadow: 0 8px 24px rgba(0,0,0,0.35);
  --shadow-strong: 0 16px 40px rgba(0,0,0,0.5);
  --nav-bg: rgba(22,27,34,0.92);
  --danger-soft: #2a1414;
}

/* =============================== */
/* RESET Y BASE */
/* =============================== */
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html, body {
  height:100%;
  width:100%;
  overflow:hidden;
  font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',sans-serif;
  background:#e5e7eb;
  color:var(--text-1);
  transition:background .4s, color .4s;
  -webkit-font-smoothing:antialiased;
}

body {
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  min-height:100vh;
}

[data-theme="dark"] body { background:#000; }

/* =============================== */
/* MARCO TIPO CELULAR (iPhone 17 / Huawei) */
/* =============================== */
.phone-frame {
  position:relative;
  width:390px;
  height:844px;
  max-height:calc(100vh - 40px);
  max-height:calc(100dvh - 40px);
  background:var(--bg);
  border-radius:52px;
  overflow:hidden;
  flex-shrink:0;
  box-shadow:
    0 0 0 12px #1a1a1a,
    0 0 0 14px #2a2a2a,
    0 0 0 15px #3a3a3a,
    0 30px 80px rgba(0,0,0,0.45),
    0 0 120px rgba(0,0,0,0.15);
}

/* Dynamic Island */
.phone-frame::before {
  content:'';
  position:absolute;
  top:14px; left:50%; transform:translateX(-50%);
  width:118px; height:34px;
  background:#000;
  border-radius:20px;
  z-index:100;
  pointer-events:none;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,0.04);
}

/* Barra home inferior */
.phone-frame::after {
  content:'';
  position:absolute;
  bottom:10px; left:50%; transform:translateX(-50%);
  width:135px; height:5px;
  background:#fff;
  opacity:.85;
  border-radius:3px;
  z-index:100;
  pointer-events:none;
  mix-blend-mode:difference;
}

.app {
  height:100%;
  display:flex;
  flex-direction:column;
  background:var(--bg);
  position:relative;
  overflow:hidden;
  border-radius:52px;
}

/* SOLO en mobile real (celular físico) quitamos el marco */
@media (max-width:480px) and (orientation:portrait) {
  body { padding:0; }
  .phone-frame {
    width:100%;
    height:100vh;
    height:100dvh;
    max-height:100vh;
    max-height:100dvh;
    border-radius:0;
    box-shadow:none;
  }
  .phone-frame::before,
  .phone-frame::after { display:none; }
  .app { border-radius:0; }
}/* =============================== */
/* SPLASH SCREEN */
/* =============================== */
.splash {
  position:absolute; inset:0; z-index:1000;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  background:linear-gradient(135deg, var(--brand-deep) 0%, var(--brand) 100%);
  transition:opacity .6s ease, visibility .6s;
  border-radius:48px;
}
.splash.hide { opacity:0; visibility:hidden; }
.splash-logo { display:flex; align-items:baseline; gap:10px; }
.splash-logo span {
  font-size:2.2rem; font-weight:800; color:#fff; letter-spacing:-0.02em;
  opacity:0; transform:translateY(20px);
  animation:logoUp .6s cubic-bezier(.2,.8,.2,1) forwards;
}
.splash-logo .sep { font-weight:300; color:rgba(255,255,255,.6); animation-delay:.15s; }
.splash-logo .gco { animation-delay:.3s; }
.splash-tag {
  margin-top:12px; color:rgba(255,255,255,.85); font-size:.8rem;
  letter-spacing:3px; text-transform:uppercase; font-weight:600;
  opacity:0; animation:logoUp .6s .5s forwards;
}
.splash-loader {
  margin-top:40px; width:120px; height:3px; background:rgba(255,255,255,.25);
  border-radius:3px; overflow:hidden;
}
.splash-loader::after {
  content:''; display:block; width:40%; height:100%; background:#fff; border-radius:3px;
  animation:load 1.2s ease-in-out infinite;
}
@keyframes logoUp { to { opacity:1; transform:translateY(0); } }
@keyframes load { 0%{transform:translateX(-100%)} 100%{transform:translateX(350%)} }

/* =============================== */
/* LOGIN SCREEN (dentro del frame) */
/* =============================== */
.login-screen {
  position:absolute; inset:0; z-index:900;
  display:flex; flex-direction:column;
  overflow:hidden;
  border-radius:48px;
  transition:opacity .5s ease, visibility .5s;
}
.login-screen.hide {
  opacity:0; visibility:hidden;
  pointer-events:none;
}

@media (max-height:700px), (max-width:420px) {
  .login-screen { border-radius:0; }
}

.login-bg {
  position:absolute; inset:0;
  background-image:url('https://upload.wikimedia.org/wikipedia/commons/c/c9/Panamericana_Highway_in_Buenos_Aires.jpg?utm_source=es.wikipedia.org&utm_campaign=index&utm_content=original');
  background-size:cover;
  background-position:center;
  z-index:0;
}
.login-bg::after {
  content:'';
  position:absolute; inset:0;
  background:linear-gradient(
    180deg,
    rgba(0,0,0,0.35) 0%,
    rgba(0,0,0,0.15) 25%,
    rgba(0,0,0,0.55) 55%,
    rgba(0,0,0,0.85) 100%
  );
}

.login-status {
  position:relative;
  z-index:2;
  display:flex; justify-content:space-between;
  padding:52px 26px 0;
  font-size:.75rem; font-weight:600; color:#fff;
}
.login-status span {
  display:flex; align-items:center; gap:6px;
}

.login-content {
  position:relative;
  z-index:2;
  margin-top:auto;
  padding:0 28px 54px;
  color:#fff;
  width:100%;
}

.login-title {
  font-size:2rem;
  font-weight:800;
  line-height:1.12;
  letter-spacing:-0.02em;
  color:#fff;
  margin-bottom:24px;
  max-width:300px;
}
.login-title .brand-tele {
  font-style:italic;
  font-weight:800;
  color:#fff;
}

.login-divider {
  width:110px;
  height:2px;
  background:#fff;
  margin:0 0 32px;
  border-radius:2px;
}

.btn-ingresar {
  display:block;
  width:100%;
  background:#0f7b3a;
  color:#fff;
  border:none;
  padding:17px 24px;
  border-radius:30px;
  font-size:.95rem;
  font-weight:600;
  font-family:inherit;
  cursor:pointer;
  transition:background .15s, transform .15s;
  box-shadow:0 8px 24px rgba(15,123,58,.4);
}
.btn-ingresar:active {
  background:#0a5c2a;
  transform:scale(.98);
}

.btn-registrarse {
  display:block;
  width:100%;
  background:transparent;
  color:#fff;
  border:none;
  padding:16px 24px;
  margin-top:6px;
  font-size:.9rem;
  font-weight:600;
  font-family:inherit;
  cursor:pointer;
  transition:opacity .15s;
}
.btn-registrarse:active { opacity:.6; }

/* =============================== */
/* HEADER */
/* =============================== */
.status-bar {
  display:flex; justify-content:space-between; padding:48px 22px 6px;
  font-size:.72rem; font-weight:600; color:var(--text-1);
}
.app-header {
  padding:6px 20px 14px;
  display:flex; justify-content:space-between; align-items:center;
  border-bottom:1px solid var(--border);
}
.logo { font-size:1.25rem; font-weight:800; display:flex; align-items:center; gap:7px; letter-spacing:-0.01em; }
.logo .ausol { color:var(--brand); }
.logo .sep { color:var(--text-3); font-weight:300; }
.logo .gco { color:var(--brand); }
.header-actions { display:flex; align-items:center; gap:12px; }
.theme-toggle {
  width:38px; height:38px; border-radius:50%; border:1px solid var(--border);
  background:var(--bg-elevated); display:flex; align-items:center; justify-content:center;
  cursor:pointer; transition:transform .2s; color:var(--text-2);
}
.theme-toggle:active { transform:scale(.9); }
.theme-toggle svg { width:18px; height:18px; }
[data-theme="light"] .icon-moon { display:none; }
[data-theme="dark"] .icon-sun { display:none; }
.user-avatar {
  width:40px; height:40px; border-radius:50%;
  background:linear-gradient(135deg, var(--brand), var(--brand-deep));
  display:flex; align-items:center; justify-content:center;
  color:#fff; font-weight:700; font-size:.85rem; cursor:pointer;
  box-shadow:var(--shadow);
}

/* =============================== */
/* CONTENIDO SCROLLEABLE */
/* =============================== */
.app-content {
  flex:1; overflow-y:auto; -webkit-overflow-scrolling:touch;
  padding:16px 20px 20px; position:relative;
}
.app-content::-webkit-scrollbar { width:0; }

.ptr-indicator {
  position:absolute; top:-50px; left:50%; transform:translateX(-50%);
  width:36px; height:36px; border-radius:50%;
  background:var(--bg-card); box-shadow:var(--shadow);
  display:flex; align-items:center; justify-content:center;
  color:var(--ausol); transition:transform .3s, opacity .3s;
}
.ptr-indicator svg { width:18px; height:18px; animation:spin 1s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

/* =============================== */
/* TABS */
/* =============================== */
.tab-content { display:none; }
.tab-content.active { display:block; animation:slideInRight .35s cubic-bezier(.2,.8,.2,1); }
.tab-content.slide-left { animation:slideInLeft .35s cubic-bezier(.2,.8,.2,1); }
@keyframes slideInRight { from{opacity:0; transform:translateX(30px)} to{opacity:1; transform:translateX(0)} }
@keyframes slideInLeft { from{opacity:0; transform:translateX(-30px)} to{opacity:1; transform:translateX(0)} }

.tab-content.active > * { animation:fadeUp .4s cubic-bezier(.2,.8,.2,1) backwards; }
.tab-content.active > *:nth-child(1){animation-delay:.05s}
.tab-content.active > *:nth-child(2){animation-delay:.1s}
.tab-content.active > *:nth-child(3){animation-delay:.15s}
.tab-content.active > *:nth-child(4){animation-delay:.2s}
.tab-content.active > *:nth-child(5){animation-delay:.25s}
.tab-content.active > *:nth-child(6){animation-delay:.3s}
@keyframes fadeUp { from{opacity:0; transform:translateY(16px)} to{opacity:1; transform:translateY(0)} }

/* =============================== */
/* COMPONENTES */
/* =============================== */
.card {
  background:var(--bg-card); border-radius:20px; border:1px solid var(--border);
  box-shadow:var(--shadow); overflow:hidden;
}

.campaign-banner {
  background:linear-gradient(135deg, var(--gco-deep), var(--gco));
  border-radius:20px; padding:18px; color:#fff; position:relative;
  overflow:hidden; margin-bottom:16px; box-shadow:var(--shadow-strong);
}
.campaign-banner::before {
  content:''; position:absolute; top:-40px; right:-40px; width:140px; height:140px;
  background:radial-gradient(circle, rgba(230,126,34,.35), transparent 70%); border-radius:50%;
}
.campaign-emergency {
  position:absolute; top:14px; right:14px; background:#dc2626; color:#fff;
  padding:5px 11px; border-radius:12px; font-size:.6rem; font-weight:700; letter-spacing:.3px;
}
.campaign-icon { font-size:1.9rem; margin-bottom:8px; }
.campaign-title { font-weight:800; font-size:1.05rem; color:#f5b042; line-height:1.25; }
.campaign-message { font-size:.85rem; opacity:.95; margin:6px 0 10px; line-height:1.45; }
.campaign-tag {
  display:inline-block; background:rgba(230,126,34,.25); color:#f5b042;
  padding:3px 11px; border-radius:12px; font-size:.6rem; font-weight:700; letter-spacing:.5px;
}

.user-card {
  background:linear-gradient(135deg, var(--gco), var(--gco-deep));
  border-radius:20px; padding:20px; color:#fff; margin-bottom:16px;
  position:relative; overflow:hidden; box-shadow:var(--shadow-strong);
}
.user-card::after {
  content:''; position:absolute; bottom:-60px; right:-30px; width:180px; height:180px;
  background:radial-gradient(circle, rgba(230,126,34,.25), transparent 70%); border-radius:50%;
}
.user-card .greeting { font-size:.7rem; opacity:.85; }
.user-card .name { font-size:1.25rem; font-weight:800; margin:3px 0 4px; }
.user-card .user-id { font-size:.68rem; opacity:.75; font-family:ui-monospace,monospace; }
.points-row {
  display:flex; justify-content:space-between; margin-top:16px; padding-top:16px;
  border-top:1px solid rgba(255,255,255,.18); position:relative; z-index:1;
}
.points-item { text-align:center; flex:1; }
.points-item .number { font-size:1.25rem; font-weight:800; }
.points-item .label { font-size:.6rem; opacity:.75; margin-top:2px; }

/* =============================== */
/* AUTOPISTAS */
/* =============================== */
.section-title { display:flex; justify-content:space-between; align-items:center; margin:20px 0 12px; }
.section-title h3 { font-size:1rem; font-weight:800; color:var(--text-1); display:flex; align-items:center; gap:8px; }
.section-title a { font-size:.72rem; color:var(--ausol); text-decoration:none; font-weight:700; cursor:pointer; }

.highways-row {
  display:flex; gap:10px; overflow-x:auto;
  padding-bottom:4px; margin:0 -20px;
  padding-left:20px; padding-right:20px;
  scrollbar-width:none;
}
.highways-row::-webkit-scrollbar { display:none; }
.highway-card {
  flex-shrink:0; width:150px;
  background:var(--bg-card);
  border:1px solid var(--border);
  border-radius:14px; padding:14px;
  cursor:pointer; transition:background .15s, transform .15s;
  position:relative;
  box-shadow:var(--shadow);
}
.highway-card:active { background:var(--bg-elevated); transform:scale(.97); }
.highway-logo {
  width: 100%;
  height: 70px;
  border-radius: 10px;
  background: var(--bg-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  overflow: hidden;
  padding: 8px;
  border: 1px solid var(--border);
}
.highway-logo img {
  width:100%;
  height:100%;
  object-fit:contain;
  display:block;
}
.highway-logo svg {
  width:22px;
  height:22px;
  color:var(--brand);
}
.highway-name {
  font-weight:800; font-size:.85rem; color:var(--text-1);
  letter-spacing:-0.01em;
}
.highway-sub { font-size:.68rem; color:var(--text-2); margin-top:2px; }
.highway-arrow {
  position:absolute; top:14px; right:14px; color:var(--text-3);
}
.highway-arrow svg { width:14px; height:14px; }

/* Ad banner */
.ad-banner {
  background:linear-gradient(135deg, var(--ausol-soft), var(--bg-card));
  border:1px solid var(--ausol); border-radius:20px; padding:18px;
  margin-bottom:16px; position:relative; overflow:hidden; box-shadow:var(--shadow);
}
.ad-label {
  font-size:.55rem; text-transform:uppercase; letter-spacing:1.5px;
  color:var(--ausol-deep); font-weight:700; display:flex; align-items:center; gap:5px;
}
[data-theme="dark"] .ad-label { color:var(--ausol); }
.ad-title { font-weight:800; font-size:1.1rem; color:var(--text-1); margin-top:6px; }
.ad-subtitle { font-size:.8rem; color:var(--text-2); margin:4px 0 14px; }
.ad-cta {
  display:inline-flex; align-items:center; gap:6px;
  background:linear-gradient(135deg, var(--ausol), var(--ausol-deep));
  color:#fff; padding:9px 20px; border-radius:24px; font-size:.78rem; font-weight:700;
  border:none; cursor:pointer; box-shadow:0 4px 14px rgba(230,126,34,.35);
  transition:transform .15s;
}
.ad-cta:active { transform:scale(.95); }
.ad-cupon {
  position:absolute; top:14px; right:14px; background:var(--ausol); color:#fff;
  padding:5px 12px; border-radius:12px; font-size:.7rem; font-weight:800;
  box-shadow:0 4px 10px rgba(230,126,34,.4);
}
.ad-geo { font-size:.65rem; color:var(--text-3); margin-top:10px; display:flex; align-items:center; gap:5px; }

/* Ofertas */
.offer-card {
  display:flex; background:var(--bg-card); border-radius:18px; padding:15px;
  margin-bottom:12px; border:1px solid var(--border); align-items:center; gap:14px;
  box-shadow:var(--shadow); transition:transform .15s;
}
.offer-card:active { transform:scale(.98); }
.offer-icon {
  width:52px; height:52px; background:var(--ausol-soft); border-radius:14px;
  display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--ausol);
}
.offer-icon svg { width:26px; height:26px; }
.offer-info { flex:1; min-width:0; }
.offer-info .name { font-weight:700; font-size:.88rem; color:var(--text-1); }
.offer-info .desc { font-size:.72rem; color:var(--text-2); margin-top:2px; }
.offer-info .distance { font-size:.62rem; color:var(--text-3); display:flex; align-items:center; gap:4px; margin-top:4px; }
.offer-btn {
  background:linear-gradient(135deg, var(--ausol), var(--ausol-deep));
  color:#fff; border:none; padding:8px 16px; border-radius:20px;
  font-size:.68rem; font-weight:700; cursor:pointer; flex-shrink:0;
  box-shadow:0 3px 10px rgba(230,126,34,.3); transition:transform .15s;
}
.offer-btn:active { transform:scale(.93); }
.offer-btn.outline { background:transparent; border:1.5px solid var(--ausol); color:var(--ausol); box-shadow:none; }

/* Rewards */
.rewards-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin:12px 0; }
.reward-item {
  background:var(--bg-card); border-radius:18px; padding:16px 8px; text-align:center;
  border:1px solid var(--border); box-shadow:var(--shadow);
}
.reward-item .icon { color:var(--ausol); display:flex; justify-content:center; }
.reward-item .icon svg { width:28px; height:28px; }
.reward-item .name { font-size:.65rem; font-weight:700; color:var(--text-1); margin-top:8px; }
.reward-item .points { font-size:.6rem; color:var(--text-2); margin-top:2px; }
.btn-redeem {
  background:var(--gco); color:#fff; border:none; padding:6px 14px; border-radius:14px;
  font-size:.6rem; font-weight:700; margin-top:8px; cursor:pointer; transition:transform .15s;
}
.btn-redeem:active { transform:scale(.93); }

/* Ruta */
.route-header {
  display:flex; align-items:center; gap:13px; background:var(--bg-card);
  border-radius:18px; padding:15px 16px; margin-bottom:16px; border:1px solid var(--border);
  box-shadow:var(--shadow);
}
.route-icon { color:var(--ausol); }
.route-icon svg { width:26px; height:26px; }
.route-info { flex:1; }
.route-info .from { font-size:.7rem; color:var(--text-2); }
.route-info .to { font-size:.92rem; font-weight:800; color:var(--text-1); margin-top:1px; }
.route-info .time { font-size:.7rem; color:var(--ausol); font-weight:700; margin-top:2px; }
.btn-start {
  background:linear-gradient(135deg, var(--ausol), var(--ausol-deep)); color:#fff;
  border:none; padding:9px 16px; border-radius:24px; font-size:.7rem; font-weight:700;
  cursor:pointer; box-shadow:0 3px 10px rgba(230,126,34,.3); transition:transform .15s;
}
.btn-start:active { transform:scale(.93); }

#map {
  height:220px; border-radius:20px; margin-bottom:16px;
  box-shadow:var(--shadow); border:1px solid var(--border); z-index:1;
}

.route-steps { background:var(--bg-card); border-radius:18px; padding:15px 17px; border:1px solid var(--border); margin-bottom:16px; box-shadow:var(--shadow); }
.step { display:flex; gap:13px; padding:9px 0; border-bottom:1px solid var(--border); align-items:flex-start; }
.step:last-child { border-bottom:none; }
.step .num {
  width:24px; height:24px; background:linear-gradient(135deg, var(--ausol), var(--ausol-deep));
  color:#fff; border-radius:50%; display:flex; align-items:center; justify-content:center;
